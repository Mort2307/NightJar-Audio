rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function accountData() {
      return firestore.get(/databases/(default)/documents/accounts/$(request.auth.uid)).data;
    }

    function activeProfessional(role) {
      return signedIn()
        && accountData().status == 'active'
        && (
          accountData().role == role
          || accountData().get('approvedProfessionalRoles', []).hasAny([role])
        );
    }

    function activeCreator() {
      return activeProfessional('creator');
    }

    function ownsEditableRelease(releaseId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/releases/$(releaseId)).data.creatorUserId == request.auth.uid
        && firestore.get(/databases/(default)/documents/releases/$(releaseId)).data.status != 'released';
    }

    function supportedAudio() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && (
          request.resource.contentType == 'audio/mpeg'
          || request.resource.contentType == 'audio/mp3'
          || request.resource.contentType == 'audio/wav'
          || request.resource.contentType == 'audio/x-wav'
          || request.resource.contentType == 'audio/mp4'
          || request.resource.contentType == 'audio/x-m4a'
          || request.resource.contentType == 'audio/ogg'
          || request.resource.contentType == 'audio/webm'
        );
    }

    // Administrator-only temporary audio probes. No read access, never
    // part of a release or showcase, and always deleted after verification.
    match /audio-upload-diagnostics/{userId}/{fileId} {
      allow read: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'mike.owen230792@gmail.com',
          'megan.wright666@hotmail.com',
          'nightjar.audio.app@gmail.com'
        ]
        && request.resource.size <= 10 * 1024 * 1024
        && supportedAudio();
      allow update: if false;
      allow delete: if signedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'mike.owen230792@gmail.com',
          'megan.wright666@hotmail.com',
          'nightjar.audio.app@gmail.com'
        ];
    }

    match /release-audio/{userId}/{releaseId}/{fileId} {
      allow read: if false;
      allow create: if activeCreator()
        && request.auth.uid == userId
        && ownsEditableRelease(releaseId)
        && supportedAudio();
      allow update: if false;
      // Published masters must be withdrawn through the protected backend
      // workflow, not deleted accidentally from the client storage SDK.
      allow delete: if signedIn()
        && request.auth.uid == userId
        && ownsEditableRelease(releaseId);
    }

    match /editor-showcase/{userId}/{itemId}/{slot}/{fileId} {
      allow read: if false;
      allow create: if activeProfessional('editor')
        && request.auth.uid == userId
        && (slot == 'before' || slot == 'after')
        && firestore.get(/databases/(default)/documents/editorPortfolio/$(itemId)).data.ownerUserId == request.auth.uid
        && (
          firestore.get(/databases/(default)/documents/editorPortfolio/$(itemId)).data.status == 'draft'
          || firestore.get(/databases/(default)/documents/editorPortfolio/$(itemId)).data.status == 'changes'
          || firestore.get(/databases/(default)/documents/editorPortfolio/$(itemId)).data.status == 'rejected'
        )
        && supportedAudio();
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
