{
  "name": "nightjar-functions",
  "private": true,
  "version": "1.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "install-scripts:review": "npm install-scripts ls",
    "audit:guard": "node scripts/audit-known-advisories.mjs",
    "test:entitlements": "npm run build && node --test lib/entitlements.test.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
