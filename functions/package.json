{
  "name": "nightjar-functions",
  "private": true,
  "version": "1.0.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "install-scripts:review": "npm install-scripts ls",
    "audit:guard": "node scripts/audit-known-advisories.mjs",
    "test:entitlements": "npm run build && node --test lib/entitlements.test.js",
    "test:creator-pool": "npm run build && node --test lib/creator-pool.test.js",
    "test:commitment-eligibility": "npm run build && node --test lib/commitment-eligibility.test.js",
    "test:profile-types": "npm run build && node --test lib/profile-types.test.js",
    "test:systems": "npm run build && node --test lib/profile-types.test.js lib/commitment-eligibility.test.js lib/creator-pool.test.js lib/finance-settlement.test.js lib/finance-policy.test.js",
    "test:finance-settlement": "npm run build && node --test lib/finance-settlement.test.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@simplewebauthn/server": "^14.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "uuid": "11.1.1",
    "body-parser": "2.4.0",
    "qs": "6.16.1",
    "@google-cloud/firestore": {
      "@google-cloud/firestore-api": "^0.7.0"
    }
  }
}
