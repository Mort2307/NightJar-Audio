{
  "name": "nightjar-audio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:firebase": "vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "validate": "npm run typecheck && npm run build && npm run validate:contracts && npm run validate:bundle",
    "validate:contracts": "node scripts/product-contracts.mjs && node scripts/accessibility-contracts.mjs && node scripts/security-contracts.mjs && npm run validate:community",
    "validate:bundle": "node scripts/bundle-budget.mjs",
    "validate:community": "node scripts/community-contracts.mjs"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
