{
  "name": "nightjar-audio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:firebase": "vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "validate": "npm run typecheck && npm run build && npm run validate:contracts && npm run validate:professional-intake && npm run validate:didit && npm run validate:nightjar-economy && npm run validate:community && npm run validate:security && npm run validate:release-hardening && npm run validate:bundle",
    "validate:contracts": "node scripts/product-contracts.mjs && node scripts/accessibility-contracts.mjs && node scripts/security-contracts.mjs && node scripts/firebase-callable-contracts.mjs",
    "validate:bundle": "node scripts/bundle-budget.mjs",
    "validate:community": "node scripts/community-contracts.mjs",
    "install-scripts:review": "npm install-scripts ls",
    "audit:prod": "node scripts/audit-production.mjs",
    "validate:security": "npm run audit:prod",
    "validate:launch": "node scripts/launch-readiness.mjs",
    "validate:nightjar-economy": "node scripts/nightjar-economy-contracts.mjs",
    "validate:release-hardening": "node scripts/release-hardening-contracts.mjs && node scripts/finance-simulator-tests.mjs",
    "validate:professional-intake": "node scripts/professional-application-bank-contracts.mjs",
    "validate:didit": "node scripts/didit-contracts.mjs",
    "setup:didit:live": "node scripts/setup-didit-live.mjs",
    "setup:didit:sandbox": "node scripts/setup-didit-sandbox.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.25.12": true
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
